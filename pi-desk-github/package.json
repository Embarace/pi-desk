{
  "name": "pi-desk",
  "productName": "Pi Desk",
  "version": "0.2.5",
  "description": "桌面版 pi 智能体客户端 —— 自定义背景、启动动画与音频，本地优先",
  "author": "Pi Desk",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:renderer": "vite build",
    "start": "electron .",
    "icon": "node scripts/gen-icon.js",
    "dist": "npm run icon && npm run build:renderer && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e-smoke.mjs && node scripts/e2e-deep.mjs && node scripts/e2e-startup.mjs && node scripts/e2e-onboard.mjs && node scripts/e2e-manage.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "marked": "^16.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.63.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.pidesk.app",
    "productName": "Pi Desk",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
